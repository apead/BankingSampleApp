<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BankingApp.Views.TransactionRecordView"
             Title="TransactionRecordView">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Entry Placeholder="Enter Reference" Text="{Binding Reference}"/>
        <Entry Placeholder="Enter Amount" Text="{Binding Amount}"/>

        <Button Text="Submit" Clicked="SubmitClicked"/>
    </VerticalStackLayout>
    
    
</ContentPage>